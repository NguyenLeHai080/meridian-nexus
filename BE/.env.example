APP_NAME=Northstar API
APP_ENV=local
APP_DEBUG=false
APP_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:////data/database.sqlite
REDIS_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
SESSION_COOKIE=northstar_session
SESSION_LIFETIME_MINUTES=60
COOKIE_SECURE=false
API_RATE_LIMIT=240
LOGIN_RATE_LIMIT=8
TRUSTED_PROXY_NETWORKS=
SESSION_BIND_IP=false
SESSION_BIND_USER_AGENT=true
REQUIRE_EMAIL_VERIFICATION=false
REQUIRE_PRIVILEGED_MFA=false
AUTH_ACTION_TOKEN_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
MAX_REQUEST_BYTES=1048576
SESSION_TOUCH_INTERVAL_SECONDS=300
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000
